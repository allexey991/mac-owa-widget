<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ASCII ONLY. codesign parses this file with AMFIUnserializeXML, which
         rejects non-ASCII bytes even inside comments and fails the build with
         "AMFIUnserializeXML: syntax error near line N". `plutil -lint` accepts
         such a file, so it will not warn you. Keep dashes and quotes plain. -->
    <!-- Builds signed with a certificate (Developer ID releases, Apple
         Development). Same keys as OWAWidget-dev.entitlements without
         disable-library-validation: Sparkle is re-signed with the same Team ID,
         so library validation stays on (verified on a probe, 2026-10-05).
         Keep the shared keys in sync between the two files. -->
    <!-- Outbound HTTPS to Exchange servers -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Read access to the calendars macOS already syncs (EventKit accounts).
         Required because the Makefile signs with hardened runtime: outside the
         sandbox this key is what lets the process reach a TCC-protected resource
         at all. Without it requestFullAccessToEvents() returns false in
         milliseconds, the status stays notDetermined and no system prompt is
         ever shown - verified on a probe build, 2026-08-22. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
